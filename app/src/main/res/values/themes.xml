<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FastReader" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <!-- 하단 도구 막대 버튼: 아이콘 위, 글자 아래 -->
    <style name="Widget.FastReader.BottomAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">2dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
